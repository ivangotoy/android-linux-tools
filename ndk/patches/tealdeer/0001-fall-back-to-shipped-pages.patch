+// android-linux-tools: tldr-pages shipped with the module (read-only; never updated or cleared by tealdeer)
+const SHIPPED_PAGES_DIR: &str = "/system/etc/android-linux-tools/share/tldr";
+
+// android-linux-tools: a pages directory with no `pages.*` language directory has no pages (none downloaded yet,
+// or an `--update` that failed after creating the directory)
+fn has_pages(dir: &Path) -> bool {
+    std::fs::read_dir(dir).is_ok_and(|mut entries| {
+        entries.any(|e| e.is_ok_and(|e| e.file_name().to_string_lossy().starts_with("pages.")))
+    })
+}

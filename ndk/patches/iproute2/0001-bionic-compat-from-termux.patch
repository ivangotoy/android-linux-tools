+#ifdef __ANDROID__
+#include <termios.h>
+/* bionic has no getpass(): read one line from the terminal with echo off. */
+static char *getpass(const char *prompt)
+{
+	static char buf[256];
+	struct termios old, noecho;
+	FILE *in = fopen("/dev/tty", "r+");
+	FILE *out = in;
+	int restore = 0;
+	size_t n;
+
+	if (!in) {
+		in = stdin;
+		out = stderr;
+	}
+	fputs(prompt, out);
+	fflush(out);
+	if (tcgetattr(fileno(in), &old) == 0) {
+		noecho = old;
+		noecho.c_lflag &= ~ECHO;
+		restore = tcsetattr(fileno(in), TCSAFLUSH, &noecho) == 0;
+	}
+	if (!fgets(buf, sizeof(buf), in))
+		buf[0] = '\0';
+	if (restore) {
+		tcsetattr(fileno(in), TCSAFLUSH, &old);
+		fputc('\n', out);
+	}
+	n = strlen(buf);
+	if (n && buf[n - 1] == '\n')
+		buf[n - 1] = '\0';
+	if (in != stdin)
+		fclose(in);
+	return buf;
+}
+#endif
+

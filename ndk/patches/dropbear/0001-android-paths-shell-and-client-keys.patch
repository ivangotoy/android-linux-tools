+#ifdef __ANDROID__
+/* Client key directory: $HOME/.ssh when HOME is set, is not "/" and $HOME/.ssh (or $HOME, so that
+   .ssh can be created) is writable; otherwise ANDROID_DROPBEAR_DIR. Returns a malloced path. */
+char * android_ssh_dir() {
+	const char *home = getenv("HOME");
+	if (home && home[0] != '\0' && strcmp(home, "/") != 0) {
+		size_t len = strlen(home) + 6;
+		char *dir = m_malloc(len);
+		snprintf(dir, len, "%s/.ssh", home);
+		if (access(dir, W_OK | X_OK) == 0
+				|| (access(dir, F_OK) != 0 && access(home, W_OK | X_OK) == 0)) {
+			return dir;
+		}
+		m_free(dir);
+	}
+	return m_strdup(ANDROID_DROPBEAR_DIR);
+}
+
+/* bionic has no getpass(): read a line from /dev/tty with echo off */
+char * getpass(const char *prompt) {
+	static char buf[256];
+	struct termios old, noecho;
+	int fd, restore = 0;
+	size_t n = 0;
+	char c;
+
+	fd = open("/dev/tty", O_RDWR | O_NOCTTY | O_CLOEXEC);
+	if (fd < 0) {
+		return NULL;
+	}
+	if (tcgetattr(fd, &old) == 0) {
+		noecho = old;
+		noecho.c_lflag &= ~(ECHO | ISIG);
+		noecho.c_lflag |= ECHONL;
+		restore = tcsetattr(fd, TCSAFLUSH, &noecho) == 0;
+	}
+	if (prompt) {
+		(void)write(fd, prompt, strlen(prompt));
+	}
+	while (read(fd, &c, 1) == 1 && c != '\n' && c != '\r') {
+		if (n < sizeof(buf) - 1) {
+			buf[n++] = c;
+		}
+	}
+	buf[n] = '\0';
+	if (restore) {
+		tcsetattr(fd, TCSAFLUSH, &old);
+	}
+	close(fd);
+	return buf;
+}
+#endif
+
